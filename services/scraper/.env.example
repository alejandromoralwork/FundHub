# Data module settings on the VM. Copy to services/scraper/.env (git-ignored, chmod 600).
# Read by fundhub-scraper-jobs.service and fundhub-scraper-weekly.service (systemd EnvironmentFile).

# Website DB with the least-privilege role (reads providers, writes ingest_* only). Neon connection string:
DATABASE_URL=postgres://fundhub_scraper:<password>@<neon-host>/<db>?sslmode=require
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium
# RCS_SOURCE=mock
