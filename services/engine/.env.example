# FundHub Scraping Engine settings. Copy to services/engine/.env (git-ignored).
# Every value has a working default for a laptop; set only what differs.

# ---- database (the engine's OWN database, not the website's)
# ENGINE_DATABASE_URL=postgres://postgres:postgres@localhost:5434/fundhub_engine
# ENGINE_DATABASE_URL_UNPOOLED=                  (direct URL if ENGINE_DATABASE_URL goes through a pooler)

# ---- object storage for raw captures and PDFs: "fs" (folder) or "s3" (R2, MinIO, AWS, Azure via S3 gateway)
# STORAGE_DRIVER=fs
# STORAGE_ROOT=.engine-data/blobs
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=fundhub-engine
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- politeness
# ENGINE_USER_AGENT=FundHubBot/0.2 (+https://fundhub.lu/methodology; data@fundhub.lu)
# CSSF_DELAY_MS=1000
# GLEIF_DELAY_MS=500

# ---- RCS (lbr.lu, logged in with LuxTrust through `engine rcs:login`)
# RCS_PROFILE_DIR=.engine-data/rcs-profile
# RCS_HEADLESS=false
# RCS_DELAY_MS=4000
# RCS_JITTER_MS=3000
# RCS_DAILY_CAP=1500
# RCS_ACTIVE_HOURS=7-20
# RCS_FRONTIER_MISSES=30
# RCS_SEARCH_URL=https://www.lbr.lu/mjrcs-web-front/consult-search-list?search=
# RCS_ENTITY_URL_TEMPLATE=                       (direct company URL with {number}, if LBR has one)
# RCS_SEARCH_INPUT=                               (CSS selector of the search box, if the default misses)

# ---- scheduling / workers
# ENGINE_TZ=Europe/Luxembourg
# ENGINE_DISABLED_SCHEDULES=rcs_sweep,rcs_frontier   (comma list of jobs not to schedule)
# ENGINE_GROUPS=cssf,gleif,maintenance
# LOG_FORMAT=json | pretty
# LOG_LEVEL=info | debug | warn

# ---- AI web agent (phase 6)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
