# FundHub Scraping Engine settings. Copy to services/engine/.env (git-ignored).
# Every value has a working default for a laptop; set only what differs.

# ---- database (the engine's OWN database, not the website's)
# ENGINE_DATABASE_URL=postgres://postgres:postgres@localhost:5434/fundhub_engine
# ENGINE_DATABASE_URL_UNPOOLED=                  (direct URL if ENGINE_DATABASE_URL goes through a pooler)

# ---- object storage for raw captures and PDFs: "fs" (folder) or "s3" (R2, MinIO, AWS, Azure via S3 gateway)
# STORAGE_DRIVER=fs
# STORAGE_ROOT=.engine-data/blobs
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=fundhub-engine
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Capture-server copies of every received LBR page (gzip JSON; default: next to RCS_PROFILE_DIR)
# CAPTURES_DIR=.engine-data/captures

# ---- which companies keep their LBR filing PDFs (packages/engine-db/src/core/document-scope.ts)
#   cssf   = CSSF entities that are not funds (ManCos / AIFMs, banks, supervised firms, service providers) — default
#   legacy = service providers and fund general partners
# DOCUMENT_SCOPE=cssf

# ---- politeness
# ENGINE_USER_AGENT=FundHubBot/0.2 (+https://fundhub.lu/methodology; data@fundhub.lu)
# CSSF_DELAY_MS=1000
# GLEIF_DELAY_MS=500

# ---- RCS (lbr.lu, logged in with LuxTrust through `engine rcs:login`)
# RCS_PROFILE_DIR=.engine-data/rcs-profile
# RCS_HEADLESS=false
# RCS_DELAY_MS=4000
# RCS_JITTER_MS=3000
# RCS_DAILY_CAP=1500
# RCS_ACTIVE_HOURS=7-20
# RCS_FRONTIER_MISSES=30
# RCS_SEARCH_URL=https://www.lbr.lu/mjrcs-web-front/consult-search-list?search=
# RCS_ENTITY_URL_TEMPLATE=                       (direct company URL with {number}, if LBR has one)
# RCS_SEARCH_INPUT=                               (CSS selector of the search box, if the default misses)

# ---- scheduling / workers
# ENGINE_TZ=Europe/Luxembourg
# ENGINE_DISABLED_SCHEDULES=rcs_sweep,rcs_frontier   (comma list of jobs not to schedule)
# ENGINE_GROUPS=cssf,gleif,maintenance
# LOG_FORMAT=json | pretty
# LOG_LEVEL=info | debug | warn

# ---- AI web agent (phase 6)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- capture receiver (`engine capture-server`, used by the browser extension)
# CAPTURE_PORT=4477
# CAPTURE_HOST=127.0.0.1                         (keep it; on the VM Caddy forwards https://<vm>/engine/* to it)
# CAPTURE_TOKEN=                                 (required for remote use: `openssl rand -hex 32`, paste it in the extension popup)

# ---- company websites (source "website": crawl + AI extraction)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium
# WEBSITE_MAX_PAGES=8
# WEBSITE_MAX_CHARS=60000
# WEBSITE_DELAY_MS=800
# WEBSITE_BATCH=25                               (companies queued per nightly website_crawl)

# ---- news (source "news": feeds in ops.news_feeds + per-company news search)
# NEWS_DELAY_MS=1500
# NEWS_SEARCH_BATCH=40
# NEWS_SEARCH_LANGUAGE=en

# ---- the WEBSITE database (one-way: the website never reads the Intelligence DB)
# WEBSITE_DATABASE_URL_RO=postgres://fundhub_engine_ro:...@.../fundhub        (source "fundhub": providers, claims, edits — SELECT only)
# WEBSITE_DATABASE_URL_PUBLISH=postgres://fundhub_scraper:...@.../fundhub     (publish_proposals: writes ingest_* only)
