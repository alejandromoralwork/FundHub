[Unit]
Description=FundHub data module: AI web extraction of every provider
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/alejandro/projects/FundHub/services/scraper/.env

[Service]
Type=oneshot
User=alejandro
WorkingDirectory=/home/alejandro/projects/FundHub/services/scraper
# DATABASE_URL (fundhub_scraper role) and ANTHROPIC_API_KEY; template: services/scraper/.env.example
EnvironmentFile=/home/alejandro/projects/FundHub/services/scraper/.env
Environment=PATH=/home/alejandro/.nvm/versions/node/v26.13.1/bin:/usr/bin:/bin
ExecStart=/home/alejandro/.nvm/versions/node/v26.13.1/bin/node --import tsx src/cli.ts run --source ai_web --trigger schedule
TimeoutStartSec=2h
Nice=10
