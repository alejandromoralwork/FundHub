[Unit]
Description=FundHub capture receiver (browser extension, 127.0.0.1:4477)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=alejandro
WorkingDirectory=/home/alejandro/projects/FundHub/services/engine
Environment=PATH=/home/alejandro/.nvm/versions/node/v26.13.1/bin:/usr/bin:/bin
ExecStart=/home/alejandro/.nvm/versions/node/v26.13.1/bin/node --import tsx src/cli.ts capture-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
