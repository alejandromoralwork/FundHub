# Local development: a SQLite file in the project folder (created automatically).
DATABASE_URL=file:./local.db

# Production (Vercel): a Turso database. Either set these two...
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...
# ...or install the Turso integration from the Vercel Marketplace, which sets
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN (also supported).
