# ---------------------------------------------------------------- database (all parts)
# Local development needs nothing: `npm run db:local` starts Postgres on
# postgres://postgres:postgres@localhost:5433/fundhub, which is the default.
# Production: Neon (Vercel Marketplace) sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---------------------------------------------------------------- website (apps/web)
# Origin of the admin deployment; /admin/* on the website is proxied there (multi-zones).
# ADMIN_ORIGIN=https://fund-hub-admin.vercel.app
# FUNDHUB_DATABASE_URL=postgres://fundhub_web:…   (least-privilege role; overrides DATABASE_URL)
# LISTMONK_URL=https://newsletter.fundhub.lu       (newsletter sign-up; see infra/README.md)
# LISTMONK_LIST_UUID=…
# STRIPE_SECRET_KEY=sk_test_...                    (Data Intelligence membership checkout)
# STRIPE_PRICE_DATA_MEMBERSHIP=price_...           (recurring price; without it the page shows a contact form)

# ---------------------------------------------------------------- admin platform (apps/admin)
# RESEND_API_KEY=re_...
# EMAIL_FROM="FundHub <hello@fundhub.lu>"
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BOUTIQUE=price_...
# STRIPE_PRICE_MID_MARKET=price_...
# STRIPE_PRICE_INSTITUTIONAL=price_...
# STRIPE_PRICE_DATA_MEMBERSHIP=price_...           (same price as the website; labels member subscriptions)
# ANALYST_DATABASE_URL=postgres://fundhub_analyst_ro:...   (read-only SQL console)
# POSTHOG_URL=https://eu.posthog.com/project/...
# ANTHROPIC_API_KEY=sk-ant-...                     (content studio: AI drafts and social versions)
# CONTENT_EFFORT=medium
# NEXTCLOUD_URL=https://drive.fundhub.lu            (sidebar links: drive, calendar, tasks)
# TWENTY_URL=https://crm.fundhub.lu
# TWENTY_API_KEY=...                               (Inbox "Send to CRM")
# LISTMONK_URL=https://newsletter.fundhub.lu
# POSTIZ_URL=https://social.fundhub.lu              (later)

# ---------------------------------------------------------------- data module (services/scraper)
# ANTHROPIC_API_KEY=sk-ant-...
