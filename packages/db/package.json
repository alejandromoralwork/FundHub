{
  "name": "@fundhub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema, migrations, client and shared queries for every FundHub part.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:roles": "tsx scripts/roles.ts",
    "db:from-turso": "tsx scripts/migrate-from-turso.ts",
    "pipeline:import": "tsx scripts/pipelines/import-providers.ts",
    "pipeline:publish": "tsx scripts/pipelines/publish-staged.ts"
  },
  "dependencies": {
    "@fundhub/core": "*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.15.6",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
