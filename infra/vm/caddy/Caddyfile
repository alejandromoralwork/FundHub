@DOMAIN@ {
	# Authelia login portal (password + authenticator code). Public: it is the login page.
	handle /authelia* {
		reverse_proxy 127.0.0.1:9091
	}
	# FundHub capture receiver (browser extension). Machine client: protected by its Bearer token, not 2FA.
	handle_path /engine/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:4477
	}
	# FundHub Drive (FileBrowser Quantum): same Authelia 2FA as code-server; the drive trusts Remote-User.
	handle /drive* {
		# `route` keeps this exact order: drop any visitor-supplied identity, then let Authelia set the real one.
		route {
			request_header -Remote-User
			forward_auth 127.0.0.1:9091 {
				uri /authelia/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy 127.0.0.1:8090
		}
	}
	# FundHub Data Intelligence (Metabase on 127.0.0.1:3010, MB_SITE_URL=https://@DOMAIN@/bi).
	# The signed dashboards the admin console embeds (fundhub.lu/admin/intelligence) must load without a VM login:
	# their JWT, signed by the console with the embedding secret, is the authorization. Everything else under /bi
	# (the query editor, collections, admin) needs Authelia 2FA first, then the Metabase login.
	# The console also lists the dashboards (GET /api/search, /api/dashboard/embeddable) with its Metabase API key:
	# only those two read endpoints, only GET, only with an X-Api-Key header; Metabase itself checks the key.
	@biPrivate {
		path /bi/*
		not path /bi/embed/* /bi/api/embed/* /bi/app/* /bi/api/session/properties /bi/api/health
		not {
			method GET
			path /bi/api/search /bi/api/dashboard/embeddable
			header X-Api-Key *
		}
	}
	redir /bi /bi/ 308
	handle /bi/* {
		route {
			request_header -Remote-User
			forward_auth @biPrivate 127.0.0.1:9091 {
				uri /authelia/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			uri strip_prefix /bi
			reverse_proxy 127.0.0.1:3010
		}
	}
	# HanziLists (~/projects/HanziLists): public Mandarin study app, no Authelia by choice.
	# Sync API: systemd unit hanzilists-api on 127.0.0.1:4620; it strips the /hanzi prefix itself, so no strip here.
	handle /hanzi/api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:4620
	}
	# Static app (Vite build) in /srv/hanzi, deployed with `npm run deploy` in the HanziLists repo.
	redir /hanzi /hanzi/ 308
	handle_path /hanzi/* {
		root * /srv/hanzi
		encode zstd gzip
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /data/* Cache-Control "public, max-age=300"
		@page path / /index.html
		header @page Cache-Control "no-cache"
		file_server
	}
	# Everything else (code-server) requires an Authelia 2FA session.
	handle {
		route {
			request_header -Remote-User
			forward_auth 127.0.0.1:9091 {
				uri /authelia/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy 127.0.0.1:8080
		}
	}
}
