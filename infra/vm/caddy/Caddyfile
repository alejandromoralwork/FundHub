@DOMAIN@ {
	# Authelia login portal (password + authenticator code). Public: it is the login page.
	handle /authelia* {
		reverse_proxy 127.0.0.1:9091
	}
	# FundHub capture receiver (browser extension). Machine client: protected by its Bearer token, not 2FA.
	handle_path /engine/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:4477
	}
	# FundHub Drive (FileBrowser Quantum): same Authelia 2FA as code-server; the drive trusts Remote-User.
	handle /drive* {
		# `route` keeps this exact order: drop any visitor-supplied identity, then let Authelia set the real one.
		route {
			request_header -Remote-User
			forward_auth 127.0.0.1:9091 {
				uri /authelia/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy 127.0.0.1:8090
		}
	}
	# Everything else (code-server) requires an Authelia 2FA session.
	handle {
		route {
			request_header -Remote-User
			forward_auth 127.0.0.1:9091 {
				uri /authelia/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy 127.0.0.1:8080
		}
	}
}
