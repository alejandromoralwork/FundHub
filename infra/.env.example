# Copy to .env (setup.sh does this and fills the secrets). Never commit .env.

# Your domains: point an A record for each to the server's IP before starting.
DRIVE_DOMAIN=drive.fundhub.lu
CRM_DOMAIN=crm.fundhub.lu
NEWSLETTER_DOMAIN=newsletter.fundhub.lu
ACME_EMAIL=admin@fundhub.lu

# First admin accounts (change the passwords after first login).
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# Generated by setup.sh
POSTGRES_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
TWENTY_DB_PASSWORD=
LISTMONK_DB_PASSWORD=
TWENTY_APP_SECRET=
TWENTY_ENCRYPTION_KEY=

# Optional: pin versions once installed (see README)
# NEXTCLOUD_TAG=34-apache
# TWENTY_TAG=
# LISTMONK_TAG=
