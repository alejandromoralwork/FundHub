{
  "name": "fundhub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @fundhub/web",
    "dev:admin": "npm run dev -w @fundhub/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:local": "npm run db:local -w @fundhub/db",
    "db:generate": "npm run db:generate -w @fundhub/db",
    "db:migrate": "npm run db:migrate -w @fundhub/db",
    "db:seed": "npm run db:seed -w @fundhub/db",
    "db:setup": "npm run db:setup -w @fundhub/db",
    "scrape": "npm run scrape -w @fundhub/scraper --"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "5.9"
  }
}
